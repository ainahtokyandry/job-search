# Job-search agent configuration.
#
# Copy to `config.env` (or run ./setup.sh, which writes it for you).
# Plain KEY="value" lines only — this file is sourced by zsh and also parsed by
# the menu bar app, so avoid shell expansions, command substitution and comments
# on the same line as a value.

# When a search should run. Comma-separated "<Day> <HH:MM>" slots, local time.
# Day is the three-letter English abbreviation: Sun Mon Tue Wed Thu Fri Sat.
SCHEDULE="Sun 08:00, Wed 15:00"

# How often launchd wakes the runner to check whether a slot is due, in seconds.
# The runner exits immediately when nothing is due, so this is cheap. A missed
# slot (Mac asleep or off) runs at the first heartbeat after wake.
HEARTBEAT_SECONDS=900

# How many times to retry a failed slot before giving up on it.
MAX_ATTEMPTS=3

# Only report jobs posted within this many days.
MAX_AGE_DAYS=7

# Where reports are written, relative to the project directory, and how they are
# named: <REPORT_PREFIX>-<YYYY-MM-DD>.md
REPORTS_DIR="reports"
REPORT_PREFIX="job-search"

# Path to the Claude Code CLI. Leave empty to autodetect.
CLAUDE_BIN=""

# Set to 0 to silence macOS notifications.
NOTIFY=1
